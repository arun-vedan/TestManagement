# Baked into the bundle at BUILD time by CRA, not read at runtime.
# The CI build passes these as --build-arg, so these values are the
# fallback for a local production build, not the source of truth for a
# deployed image.
#
# Previously: https://srckube.com and https://srckube.com:3443 — the old
# brand, and a non-standard port that corporate networks commonly block,
# which would have failed the first customer demo from inside one.
REACT_APP_API_BASE_URL=https://api.vedan.io
REACT_APP_KEYCLOAK_BASE_URL=https://auth.vedan.io
