# Use an official Node.js runtime as a parent image
FROM node:22-alpine3.19

# Set the working directory inside the container
WORKDIR /usr/src/app

# Shared internal library (extracted Sprint 1.1, TD-04) — copied to the path
# referenced by this service's package.json ("file:../shared/service-core").
# npm turns a file: dependency into a symlink, so Node resolves requires from
# inside shared/service-core against ITS OWN node_modules, not this service's —
# it needs its own install here, independent of the consuming service. This
# matters even more for uploadService (WP-012) than the other services:
# service-core pins an OLD helmet/hpp major, while uploadService's own
# package.json intentionally uses newer majors (see index.js comment on why
# applyStandardSecurity() is not used here) — the separate installs keep
# those two dependency sets from colliding.
COPY shared/service-core /usr/src/shared/service-core
RUN npm install --prefix /usr/src/shared/service-core

# Copy package.json and package-lock.json to the working directory
COPY uploadService/package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application code to the working directory
COPY uploadService/. .

# Expose the port that the app runs on
EXPOSE 3000

# Define environment variable for production
ENV NODE_ENV=production

# Run the command to start the Node.js application
CMD ["npm","start"]
