NODE_ENV=development
PORT=3001

MONGO_URI=mongodb://127.0.0.1:27017/CHANGE_ME_DB_NAME

# WP-022 (TD-03): the legacy JWT auth system that consumed JWT_SECRET/
# JWT_EXPIRE/JWT_COOKIE_EXPIRE and the SMTP_*/FROM_* mailer config
# (routes/auth.js, controllers/auth.js, middleware/auth.js,
# utils/sendEmail.js) is retired -- see EXECUTION_LOG.md's WP-022 entry.
# Identity is Keycloak-only from here on (KeyCloak_* below).

KeyCloak_URI=http://localhost:8080
# WP-012b: outbound admin/token API calls (controllers/users.js) — separate
# from KeyCloak_URI (issuer validation only, see backend/shared/service-core/
# keycloak.js). Running this service outside Docker, both are localhost:8080;
# under docker-compose this is overridden to http://keycloak:8080.
KeyCloak_Admin_URI=http://localhost:8080
KeyCloak_Realm=srckube
KeyCloak_Secret=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_publicKey=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_clientId=node-microservice
Redis_URI=localhost
