# Use an official Node.js runtime as a parent image
FROM node:22-alpine3.19

# Set the working directory inside the container
WORKDIR /usr/src/app

# Shared internal library (Sprint 1.1, TD-04) — npm turns a file: dependency
# into a symlink, so it needs its own install, independent of this service's.
COPY shared/service-core /usr/src/shared/service-core
RUN npm install --prefix /usr/src/shared/service-core

# Copy package.json and package-lock.json to the working directory
COPY notificationService/package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application code to the working directory
COPY notificationService/. .

# Expose the port that the app runs on
EXPOSE 3000

# Define environment variable for production
ENV NODE_ENV=production

# Run the command to start the Node.js application
CMD ["npm","start"]
