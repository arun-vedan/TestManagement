{
  "name": "@srckube/service-core",
  "version": "0.1.0",
  "description": "Shared Express middleware, Keycloak config, and security wiring for srckube backend services — extracted in Sprint 1.1 to replace the 13-way boilerplate clone (TD-04).",
  "main": "index.js",
  "private": true,
