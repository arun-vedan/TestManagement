    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testMatch='**/__tests__/**/*.live.test.js'"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "express-fileupload": "^1.1.6-alpha.5",
    "express-mongo-sanitize": "^1.3.2",
    "express-rate-limit": "^5.0.0",
    "express-session": "^1.18.0",
    "helmet": "^3.21.1",
    "hpp": "^0.2.2",
    "ioredis": "^6.0.0",
    "keycloak-connect": "^25.0.4",
    "mongoose": "^5.7.1",
    "nodemailer": "^10.1.0",
    "prom-client": "15.1.3",
    "xss-clean": "^0.1.1"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.live\\.test\\.js$"
