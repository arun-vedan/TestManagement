NODE_ENV=development
PORT=3021

MONGO_URI=mongodb://127.0.0.1:27017/CHANGE_ME_DB_NAME

KeyCloak_URI=http://localhost:8080
KeyCloak_Admin_URI=http://localhost:8080
KeyCloak_Realm=srckube
KeyCloak_Secret=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_publicKey=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_clientId=node-microservice

# WP-021: requireProjectScope() -> userService (the identity service).
userService=userservice:3000
PROJECT_SCOPE_CACHE_TTL_MS=30000

# WP-030: publishEvent()/subscribe() connection -- also reused by this
# service's own per-user daily AI rate limiter (lib/rateLimiter.js).
REDIS_URI=redis://redis:6379

# ---------------------------------------------------------------------------
# WP-050 -- Provider selection (Phase E decision, 2026-08-30: generic/
# provider-agnostic, NOT hardwired to any one vendor -- see
# providers/index.js's header comment and EXECUTION_LOG.md's WP-050 report).
#
# AI_PROVIDER: 'mock' (default, deterministic, zero network -- what this
#   environment runs) or 'openai' (a real OpenAI-compatible chat/completions
#   HTTP client -- see providers/openaiProvider.js; UNTESTED against any
#   live vendor in this environment, no key/account exists here).
AI_PROVIDER=mock
# Model name passed to the provider. Ignored by 'mock'.
AI_MODEL=gpt-4o-mini
# Base URL for an OpenAI-compatible chat/completions API. Only read by the
# 'openai' provider. Swap this to point at Azure OpenAI's compatible
# endpoint or a local Ollama's OpenAI-compatible endpoint instead of
# api.openai.com -- expected to work, not verified live in this session.
AI_BASE_URL=https://api.openai.com/v1
# Generic key -- deliberately NOT a vendor-named variable (e.g. never
# ANTHROPIC_API_KEY/OPENAI_API_KEY). Only read by the 'openai' provider;
# 'mock' ignores it entirely. Leave blank while AI_PROVIDER=mock.
AI_API_KEY=CHANGE_ME_IF_USING_A_REAL_PROVIDER

# Google Gemini via its OpenAI-compatible endpoint (verified live against
# the API on 2026-09-23 -- the first real vendor this seam has been run
# against). No new provider module: Gemini exposes an OpenAI-compatible
# /chat/completions, so it runs under AI_PROVIDER=openai unchanged.
#
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash-lite
#   AI_API_KEY=<a Google AI Studio API key>
#
# MODEL CHOICE IS LEAD, NOT TASTE. Gemini's thinking models (gemini-2.5-flash
# and the 3.x line) bill reasoning against the SAME max_tokens budget this
# service's callers set, and return content:null / finish_reason:"length"
# when reasoning exhausts it. Measured on gemini-2.5-flash:
#   - GET /api/v1/ai/health (maxTokens:32, controllers/ai.js) -> 0 completion
#     tokens, content:null -> openaiProvider throws 'invalid_response'. The
#     health endpoint FAILS even though the key is good.
#   - summarize-report (maxTokens:800) -> ~764 tokens spent thinking, the
#     summary itself truncated at ~114 chars.
# gemini-2.5-flash-lite does not think by default and stays inside both
# budgets (health 'Pong.' in ~2s; a 5-candidate generate-testcases structured
# call in ~4.3s, well inside openaiProvider's 15s timeout). Prefer a thinking
# model ONLY alongside raising those maxTokens call sites.
#
# Also note: gemini-2.0-flash is retired (404 from the endpoint), and
# response_format:{type:'json_object'} -- what completeStructured() relies on
# -- is honoured by this endpoint (valid JSON returned, schema respected).

# Per-user daily cap on POST /api/v1/ai/complete and /structured (NOT
# /health, which is a diagnostic call). See lib/rateLimiter.js.
AI_DAILY_RATE_LIMIT=50

# AiInteraction retention/privacy knobs (models/AiInteraction.js). Defaults
# here match the model's own hardcoded fallback -- restated so the knob is
# visible without reading source.
#   AI_LOG_RETENTION_DAYS -- Mongo TTL index lifetime on AiInteraction docs.
#   AI_STORE_FULL_TEXT    -- 'true' to persist full prompt/response text;
#                            default 'false' stores only a short preview +
#                            a SHA-256 hash of the full text.
#   AI_LOG_PREVIEW_CHARS  -- preview length when full text is not stored.
AI_LOG_RETENTION_DAYS=30
AI_STORE_FULL_TEXT=false
AI_LOG_PREVIEW_CHARS=200
