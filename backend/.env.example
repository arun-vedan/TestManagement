# Copy this file to backend/.env and fill in the real value.
# backend/.env is gitignored and is read automatically by `docker compose`
# for variable substitution inside backend/docker-compose.yml (GR-9 pattern).
#
# Keycloak client secret for the `node-microservice` service-account client
# (realm: srckube). Used by every backend service's KeyCloak_Secret env var.
KEYCLOAK_SECRET=changeme

# WP-101 — express-session cookie signing key, used by every backend service.
# Replaces the hardcoded 'mySecret' that sat in all 18 server.js files and the
# 'test' in shared/service-core/keycloak.js.
#
# With NODE_ENV=production a service REFUSES TO START if this is unset, rather
# than falling back to a shared constant. Outside production an unset value
# generates a random per-process secret and warns; sessions then do not survive
# a restart, which is harmless because the session store is already per-process
# (an in-process MemoryStore), not shared.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme

# WP-132 — public base URL of the FRONTEND, used to build invitation links
# (".../accept-invite?token=..."). Deliberately configured rather than derived
# from the request's Host/Referer, which are attacker-controlled on a public
# endpoint and would make an invite mail an open redirect.
APP_BASE_URL=http://localhost:3000

# WP-135 — abuse and cost controls on file upload. Before these, multer ran
# with no limits and no fileFilter at all: no per-file cap, no type
# restriction, no per-tenant ceiling. With self-serve signup live that is free,
# unlimited file hosting, and one request could exhaust the disk behind Mongo.
#
# The DEFAULTS below are deliberately conservative placeholders, not the
# owner's decision. WP-135 depends on owner-provided caps; until those exist
# the mechanism is in place and the numbers are a config edit here.
#
# VALUES ARE BYTES, DIGITS ONLY. A value this cannot read exactly falls back to
# the documented default rather than removing the cap -- note that '1e9' and
# '25MB' are both REJECTED, because parseInt would otherwise read them as 1 and
# 25, installing a one-byte cap that rejects every upload and makes the service
# look broken rather than misconfigured.
UPLOAD_MAX_FILE_BYTES=26214400          # 25 MiB per file
UPLOAD_MAX_PROJECT_BYTES=2147483648     # 2 GiB per project, all attachments
UPLOAD_MAX_FILES_PER_REQUEST=10         # so one multipart cannot carry 10,000 files
#
# Comma-separated. Left blank, the defaults in
# backend/uploadService/utils/upload.js apply: images, PDF, text, CSV,
# Markdown, JSON, XML (JUnit reports), zip, mp4 and webm. Script-capable types
# (image/svg+xml, text/html) and executables are deliberately NOT in the
# default list. Both the MIME type and the file extension are checked; the
# MIME type is client-supplied, so neither is content inspection.
UPLOAD_ALLOWED_MIME_TYPES=
UPLOAD_ALLOWED_EXTENSIONS=

# WP-012b: signing secret for userService's legacy JWT register/login path
# (TD-03, still in place — retiring it is WP-022's job, not this one).
# Generate with e.g. `openssl rand -hex 32`. Used by userservice's
# JWT_SECRET env var in backend/docker-compose.yml.
JWT_SECRET=changeme

# WP-002c: local/test-only override for @srckube/service-core's per-service
# HTTP rate limiter (backend/shared/service-core/security.js). The limiter's
# hardcoded default is 100 requests / 10 min and MUST stay 100 in production
# — that is not overridden by leaving this unset. Set it here so the
# black-box API suite (scripts/run-api-tests.sh: 179 tests / 13 suites) can
# be run repeatedly inside a single 10-minute window without tripping 429s.
# Precedence: an explicit rateLimitMax passed at a service's
# applyStandardSecurity(app, {...}) call site (linkIssueService,
# defectService, requirementService: 10000; userService: 1000) always wins
# over this env var — those three/four services are unaffected by this
# setting either way. Leave unset (or delete the line) to fall back to the
# production default of 100.
# AUDIT FINDING, 2026-10-11: this file is TRACKED, so it is the documented
# default a new deployment copies. Shipping 100000 here means production runs
# with a 100,000-requests-per-10-minutes ceiling, i.e. effectively no rate
# limit, which is the opposite of what an internet-facing deployment wants and
# is exactly the sort of thing nobody re-reads after the first setup.
#
# resolveRateLimitMax() falls back to 100 when this is unset, so the safe
# production configuration is to leave it COMMENTED OUT. Raise it only in a
# local .env (gitignored) when running the black-box suites repeatedly.
#
# Note the plan's WP-101 bullet on this is wrong as written: it says to
# "confirm NODE_ENV=production so resolveRateLimitMax() returns 100".
# security.js contains ZERO references to NODE_ENV -- the value comes solely
# from this variable. NODE_ENV is already production in every container and has
# no bearing on it.
# RATE_LIMIT_MAX=100000

# WP-030: connection string for @srckube/service-core's publishEvent()/
# subscribe() (backend/shared/service-core/events.js), reaching the `redis`
# container in backend/docker-compose.yml by container name (never
# `localhost` -- see WP-012b's issuer-mismatch regression for why that
# convention exists). Distinct from userService's separate `Redis_URI` env
# var (its pre-existing existence-cache; same Redis instance, different
# consumer, different var name/casing so the two don't collide).
# Not a secret -- this Redis instance has no auth configured -- but kept
# env-driven per GR-9 so it stays overridable without a code change.
REDIS_URI=redis://redis:6379

# WP-064: credentials for scripts/mongo-backup.sh and scripts/mongo-restore.sh.
# These must be the SAME root credentials the `mongodb` service in
# backend/docker-compose.yml was started with (its
# MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD) — the backup
# scripts authenticate as that user. Per GR-9, do not copy the literal
# password out of docker-compose.yml into any script or doc; only into this
# untracked file. See docs/backup-restore-runbook.md for usage.
# WP-101 — the Mongo ROOT credentials. backend/docker-compose.yml is TRACKED
# and used to carry this password inline 27 times, so rotating it (WP-100)
# meant editing 36 occurrences across 10 tracked files. Compose now reads
# these two variables and the file holds no secret.
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASSWORD=changeme

# DEPRECATED ALIAS, same credential. Despite the name this is the Mongo ROOT
# user, not a backup-only one. Every consumer prefers MONGO_ROOT_* and falls
# back to these, so they are kept only so an existing .env keeps working.
# Delete them once everyone has pulled: with them gone the root password lives
# in exactly ONE place, which is what makes WP-100's rotation a single edit.
MONGO_BACKUP_USER=changeme
MONGO_BACKUP_PASSWORD=changeme

# WP-050: aiService's provider adapter (backend/aiService/providers/index.js).
# Provider-agnostic by design (Phase E decision, 2026-08-30) -- generic
# AI_API_KEY, never a vendor-named variable. AI_PROVIDER=mock is the
# default and what this environment actually runs (no vendor account/key
# exists here); leave the rest unset unless you are pointing this at a
# real OpenAI-compatible endpoint.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Any OpenAI-compatible gateway works under AI_PROVIDER=openai, e.g.
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1,
# AI_MODEL=anthropic/claude-sonnet-5.5 (vendor/model ids).
# Client identification for gateways that meter by client (e.g. OpenCode
# Go: AI_BASE_URL=https://opencode.ai/zen/go/v1, AI_MODEL=kimi-k3,
# AI_SESSION_HEADER=x-opencode-session). The session header is only sent
# when AI_SESSION_HEADER is set. Raise AI_TIMEOUT_MS for reasoning models.
AI_USER_AGENT=srckube-aiService/1.0
AI_SESSION_HEADER=
AI_TIMEOUT_MS=15000
# Per-user, per-day AI call ceiling. 50 is a sane production default.
# NOTE: raise this locally (e.g. 100000) if you run the black-box AI
# suites repeatedly -- a couple of full runs exhausts 50 and every
# subsequent aiService test returns 429, which looks like a failure but
# is rate limiting. Same pattern as RATE_LIMIT_MAX (WP-002c).
AI_DAILY_RATE_LIMIT=50
AI_LOG_RETENTION_DAYS=30
AI_STORE_FULL_TEXT=false
AI_LOG_PREVIEW_CHARS=200

# WP-104 -- maximum number of documents a single GET /wildcardsearch response
# may contain, across testRepoService/requirementService/defectService. These
# three routes had no cap at all before WP-104: a search matching everything
# returned every match in the project, fully hydrated, in one response. Unset
# (or set to junk/0/negative) falls back to 100 in code
# (backend/shared/service-core/utils/searchQuery.js), never to unbounded.
WILDCARD_SEARCH_MAX_RESULTS=100

# WP-130 — Keycloak realm SMTP, used by scripts/configure-keycloak-email.js.
# Mail is sent by KEYCLOAK, not by any service: the SMTP_* vars that still sit
# in backend/*/config/config.env.example are retired scaffolding from the
# deleted legacy auth system and are NOT these.
#
# SMTP_USER is the provider-issued login, not your account email (Brevo issues
# something like 8a1b2c001@smtp-brevo.com). SMTP_PASSWORD is the provider's
# SMTP key, not a v3 API key.
#
# Many providers also require the SENDING IP to be authorised. Brevo rejects an
# unauthorised one with "525 5.7.1 Unauthorized IP address", which surfaces
# through Keycloak only as an opaque "Failed to send email".
#
# SMTP_FROM must be a verified sender. Sending as a free-mail domain you do not
# control (e.g. @gmail.com) works but cannot pass SPF/DKIM alignment, so
# WP-130's "SPF, DKIM and DMARC all pass" needs a domain you own.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_PROVIDER_SMTP_LOGIN
SMTP_PASSWORD=CHANGE_ME_PROVIDER_SMTP_KEY
# vedan sends as admin@vedan.io. Verify vedan.io in Brevo (SPF include, DKIM,
# DMARC) before switching a live .env to it, or Brevo rejects every message.
SMTP_FROM=admin@vedan.io
SMTP_FROM_NAME=vedan

# --- WP-140: credential encryption (service-core credentials.js) ---------------
# Seals third-party credentials (Jira API tokens, WP-142) before they reach
# Mongo. Pass these through docker-compose.yml ONLY to services that store
# credentials; others never read them and are unaffected when unset.
# No fallback: if unset, sealing/opening a credential throws. Back the key up
# SEPARATELY from the database -- losing it loses every stored credential.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: see backend/shared/service-core/README.md "Rotating the key".
CREDENTIAL_KEYS=k1:CHANGE_ME_BASE64_32_BYTES
CREDENTIAL_ACTIVE_KEY_ID=k1

# --- Google sign-in (WP-138) -------------------------------------------------
# A Google Cloud OAuth client of type "Web application"
# (console.cloud.google.com -> APIs & Services -> Credentials).
#
# The authorized redirect URI must be registered with Google EXACTLY as:
#   {KEYCLOAK_URL}/realms/{REALM}/broker/google/endpoint
# e.g. http://localhost:8080/realms/srckube/broker/google/endpoint
# Google accepts http://localhost for development, so the flow can be built
# and proven before a real domain exists; add the production URI alongside it
# later rather than replacing it.
#
# Scopes stay "openid email profile" -- non-sensitive, so the OAuth consent
# screen needs no Google verification review.
#
# Applied by scripts/configure-keycloak-email.js, which SKIPS google sign-in
# entirely (and says so) when these are absent. The secret is never written to
# a tracked file; Keycloak stores it in the realm.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# --- AI deployment kill switch (WP-166) -------------------------------------
# Deployment-wide. Checked BEFORE the per-project AI flag, so a project admin
# cannot override it from the settings UI. Absent, empty or anything other than
# the exact string "true" means AI is OFF — it fails closed deliberately, since
# a typo that silently re-enabled a feature which sends content to a
# third-party model provider is worse than a typo that disables one.
#
# Held OFF for the closed beta: the AI features are not considered good enough
# to put in front of testers, and the beta terms state that customer content
# does not leave vedan during the beta. The per-project flag alone could not
# support that sentence.
AI_GLOBALLY_ENABLED=false
