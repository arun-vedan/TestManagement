NODE_ENV=development
PORT=3002

MONGO_URI=mongodb://127.0.0.1:27017/CHANGE_ME_DB_NAME

GEOCODER_PROVIDER=mapquest
GEOCODER_API_KEY=CHANGE_ME_UNUSED_LEGACY_PATH

FILE_UPLOAD_PATH= ./public/uploads
MAX_FILE_UPLOAD=1000000

JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=CHANGE_ME_UNUSED_LEGACY_PATH
SMTP_PASSWORD=CHANGE_ME_UNUSED_LEGACY_PATH
FROM_EMAIL=noreply@devcamper.io
FROM_NAME=DevCamper
KeyCloak_URI=http://localhost:8080
KeyCloak_Realm=srckube
KeyCloak_Secret=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_publicKey=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_clientId=node-microservice
