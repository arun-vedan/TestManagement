NODE_ENV=development
PORT=3020

MONGO_URI=mongodb://127.0.0.1:27017/CHANGE_ME_DB_NAME

KeyCloak_URI=http://localhost:8080
KeyCloak_Admin_URI=http://localhost:8080
KeyCloak_Realm=srckube
KeyCloak_Secret=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_publicKey=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE
KeyCloak_clientId=node-microservice

# WP-040 — cross-service targets this read-only service calls over HTTP
# (container:port on the Docker network, see docker-compose.yml).
requirementService=requirementservice:3000
defectService=defectservice:3000
testPlanExecutionService=testplanexecutionservice:3000
linkIssueService=linkissueservice:3000
releaseService=releaseservice:3000
istatusService=istatusservice:3000
userService=userservice:3000

# node-cron schedule for the background refresh sweep (WP-040 default: every
# 5 minutes). Standard 5-field cron syntax.
REPORT_REFRESH_CRON=*/5 * * * *
# A GET .../reports/<type> lazily recomputes when its cached entry is older
# than this (ms) -- keeps reads fast on the common case (cron/a recent
# refresh already warmed the cache) while still self-healing without
# waiting for the next cron tick.
REPORT_STALE_MS=300000
