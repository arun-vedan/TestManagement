# Copy this file to .env.test (repo root) and fill in the real client secret.
# .env.test is gitignored. It is loaded automatically by
# backend/shared/test-utils/getServiceToken.js so black-box test suites can
# obtain a real Keycloak service-account token (client_credentials grant)
# without a hardcoded secret in source.
#
# An already-exported env var of the same name (shell, CI secret) always
# takes precedence over this file.

TEST_KEYCLOAK_URL=http://localhost:8080
TEST_KEYCLOAK_REALM=srckube
TEST_KEYCLOAK_CLIENT_ID=node-microservice
TEST_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_FROM_KEYCLOAK_ADMIN_CONSOLE

# ---------------------------------------------------------------------------
# WP-101 — where the black-box suites address the product.
#
# Every suite now DEFAULTS to Kong (http://localhost:8000) and builds full
# /api/v1/... paths on top of it, so none of these need to be set for a normal
# run. They exist to retarget the suites at a different ingress (a staging
# host, or Kong inside the compose network once the published host ports are
# gone) without editing test files.
#
# Previously each suite defaulted to its service's own published host port
# (localhost:3001, :3006, :3017 and so on). That is what kept WP-101's
# "drop host port mappings" bullet blocked: 48 suite files reached past the
# gateway, so unpublishing the ports would have broken all of them at once.
# They now go through Kong, which is also what a real client does — the
# suites exercise the gateway's routes and plugins, not just the services.
TEST_KONG_URL=http://localhost:8000
# TEST_BASE_URL and the per-service variants below all default to Kong.
# Setting TEST_BASE_URL alone retargets most suites at once.
# TEST_BASE_URL=http://localhost:8000
# TEST_USER_SERVICE_URL=http://localhost:8000
# TEST_TESTREPO_URL=http://localhost:8000
# TEST_REQUIREMENT_URL=http://localhost:8000
# TEST_DEFECT_URL=http://localhost:8000
# TEST_LINKISSUE_URL=http://localhost:8000
# TEST_RELEASE_URL=http://localhost:8000
# TEST_REPORTING_URL=http://localhost:8000
# TEST_TPES_URL=http://localhost:8000
# TEST_TESTEXEC_BASE_URL=http://localhost:8000
#
# THE TWO DELIBERATE EXCEPTIONS. These two suites assert on a service's OWN
# auth layer -- keycloak.protect() rejecting a tokenless request, and the
# correlation-id middleware's behaviour on it. Kong's jwt plugin answers 401
# before such a request reaches the service, so through the gateway those
# assertions would be testing Kong instead. They therefore address the
# service directly, under names a blanket TEST_BASE_URL cannot capture:
#
#   userService/__tests__/api.test.js            TEST_USERSERVICE_DIRECT_URL
#   testPlanExecutionService/__tests__/api.test.js  TEST_TPES_DIRECT_URL
#                                                TEST_TESTREPO_DIRECT_URL
#
# When the published host ports are dropped, these two are the only suites
# that need to run INSIDE the compose network (where http://<service>:3000
# resolves). Point the *_DIRECT_URL vars at the container hostnames there;
# do not rewrite the suites to use Kong, which would delete the coverage
# rather than move it.
# TEST_USERSERVICE_DIRECT_URL=http://userservice:3000
# TEST_TPES_DIRECT_URL=http://testplanexecutionservice:3000
# TEST_TESTREPO_DIRECT_URL=http://testreposervice:3000
#
# aiService's suites still default to their direct port; that package is being
# worked on separately (its AI provider is mid-change) and was left untouched.
